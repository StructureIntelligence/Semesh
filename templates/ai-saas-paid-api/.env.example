# Copy to `.env` for LOCAL development only. `semesh deploy` injects the production values for you —
# you do NOT set these in production. NEVER commit a real key. Placeholders only.

# Injected automatically in production by `semesh deploy`. Authenticates this app to Semesh.
# Only needed locally if you want to test billable calls outside the platform.
SEMESH_APP_API_KEY=

# Semesh API base (default is correct for production; override only for local/staging).
# SEMESH_BASE_URL=https://api.semesh.net

# Discovery query and selectors. Search must resolve one public Model Service Unit; Unit detail must
# advertise the exact nested Action and a uniquely placed model-choice ref or the request fails.
# Only the model ID is configured: model_revision is taken exactly from the advertised ref.
# SEMESH_MODEL_SEARCH_QUERY=DeepSeek text generation
# SEMESH_MODEL_ACTION_ID=chat
# SEMESH_MODEL_CHOICE_ID=deepseek-v3

# Maximum amount this app permits the effect-zero quote to authorize. The wire value is a JSON
# integer and must remain within JavaScript's non-negative safe-integer range. 1 Aev = 100000000 atoms.
# SEMESH_BUDGET_CEILING_AEV_ATOMS=5000000000

# Display-only pre-call price estimate shown in the UI (Aev). The real charge comes from the platform.
# PRICE_ESTIMATE_AEV=2
