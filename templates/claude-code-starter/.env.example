# Copy to .env.local for local development. Never commit real values.
# In production, Semesh injects these automatically at deploy time —
# you do NOT need to set them yourself.

# Base URL for the Semesh API (default is fine).
SEMESH_BASE_URL=https://api.semesh.net

# Managed database credentials (auto-injected on deploy). Placeholders only:
SEMESH_PROJECT_ID=
SEMESH_PROJECT_SERVER_KEY=
