# Copy to .env.local for local dev. NEVER commit real values.
# `semesh deploy` injects the real versions of these in production —
# you do not set them by hand for a deployed app.

# Semesh API base (default is fine).
SEMESH_BASE_URL=https://api.semesh.net

# App API key — authorizes the Action quote/invoke/observation sequence. Injected on deploy.
SEMESH_APP_API_KEY=

# Managed database — project id + server key. Injected on deploy.
SEMESH_PROJECT_ID=
SEMESH_PROJECT_SERVER_KEY=

# Canonical "Polish with AI" selection. Public Search is anonymous and returns
# meta.catalog_token; the server forwards that token only to the corresponding
# public Unit Detail GET. Copy one live-discovered Unit id and one nested Action
# id exactly. Missing/stale values fail closed before quote/invoke; there is no
# legacy capability or local execution fallback.
SEMESH_POLISH_QUERY=polish text with DeepSeek
SEMESH_POLISH_UNIT_ID=
SEMESH_POLISH_ACTION_ID=

# Positive decimal environment value for a JSON-integer Aev-atom budget. This
# JavaScript template accepts only values at or below Number.MAX_SAFE_INTEGER;
# larger or non-integer values fail closed before the effect-zero quote.
SEMESH_POLISH_CEILING_AEV_ATOMS=
