# Copy to .env for LOCAL development only. Never commit real values.
# In production, Semesh INJECTS SEMESH_APP_API_KEY for you — you do not set it.

# The app's server-side runtime key. Authenticates this app to Semesh.
# NEVER expose this to the browser. Placeholder only — paste your own to run locally.
SEMESH_APP_API_KEY=

# Public Search selector and the nested Action this app intends to use. The Unit ID,
# UnitActionRef, Catalog pin, model_choice_pin revision, and catalog token always come from live
# Search/Detail. The template selects model_id deepseek-v3 only from the Action's model_choices.
SEMESH_UNIT_QUERY=DeepSeek chat
SEMESH_ACTION_ID=chat

# Required explicit per-operation budget ceiling. The server parses it into the JSON-integer
# wire type and accepts only a positive JavaScript-safe integer; unsafe int64 values fail closed.
# 1 Aev = 100000000 atoms. Choose this value for your app; the template has no default.
SEMESH_BUDGET_CEILING_AEV_ATOMS=

# Optional: quote/invoke deadline horizon in seconds (30-3600; defaults to 300).
SEMESH_ACTION_DEADLINE_SECONDS=300

# Optional: bounded timeout for anonymous Search/Detail and the read-only quote
# (100-60000 milliseconds; defaults to 15000). It never aborts invoke.
SEMESH_QUOTE_TIMEOUT_MS=

# Optional: override the API base (defaults to https://api.semesh.net).
SEMESH_BASE_URL=

# Optional: local port (defaults to 8080).
PORT=
