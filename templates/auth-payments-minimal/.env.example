# Copy to .env for LOCAL development only. Never commit real values.
# In production, Semesh INJECTS SEMESH_APP_API_KEY for you — you do not set it.

# The app's server-side runtime key. Authenticates this app to Semesh.
# NEVER expose this to the browser. Placeholder only — paste your own to run locally.
SEMESH_APP_API_KEY=

# Optional: override the API base (defaults to https://api.semesh.net).
SEMESH_BASE_URL=

# Optional: local port (defaults to 8080).
PORT=
