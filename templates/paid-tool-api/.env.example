# Copy to .env for LOCAL development only. Never commit a real .env.
# When you `semesh deploy`, Semesh injects these for you — you do not set them in production.

# Semesh API base URL (defaults to https://api.semesh.net if unset).
SEMESH_BASE_URL=

# The app's runtime API key. Injected automatically on deploy. For local testing only, paste a key here.
# This authenticates the APP; the per-call charge still lands on the logged-in user (via X-Semesh-Payer).
SEMESH_APP_API_KEY=

# Optional: the capability or offer id this endpoint resells. Defaults to "llm.chat".
# TOOL_CAPABILITY_ID=llm.chat
