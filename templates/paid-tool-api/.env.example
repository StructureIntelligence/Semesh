# Copy to .env for LOCAL development only. Never commit a real .env.
# When you `semesh deploy`, Semesh injects these for you — you do not set them in production.

# Semesh API base URL (defaults to https://api.semesh.net if unset).
SEMESH_BASE_URL=

# The app's runtime API key. Injected automatically on deploy. For local testing only, paste a key here.
# This authenticates the APP; the per-call charge still lands on the logged-in user (via X-Semesh-Payer).
SEMESH_APP_API_KEY=

# Search resolves Semesh's one public Model Unit. The pinned detail must advertise this exact nested
# Action and uniquely placed model-choice ref; none is a provider or alternate execution id. Only
# the model ID is configured: model_revision is taken exactly from the advertised ref.
# SEMESH_MODEL_SEARCH_QUERY=DeepSeek text generation
# SEMESH_MODEL_ACTION_ID=chat
# SEMESH_MODEL_CHOICE_ID=deepseek-v3

# Quote ceiling. The wire value is a non-negative JSON safe integer; strings/unsafe numbers fail
# closed. 1 Aev = 100000000 atoms.
# SEMESH_BUDGET_CEILING_AEV_ATOMS=5000000000
